# --- ΓΕΜΗ (Greek Business Registry) Open Data ---
# Register at https://opendata.businessportal.gr/register/ to get a key.
# Docs: https://opendata-api.businessportal.gr/opendata/docs/
# Rate limit: 8 requests/minute. Without a key the app runs on realistic
# demo data for this source.
GEMI_API_KEY=
GEMI_BASE_URL=https://opendata-api.businessportal.gr/api/opendata/v1

# --- ΚΗΜΔΗΣ (Public Procurement Portal) Open Data ---
# Read-only GET access currently does not require a key.
PROCUREMENT_BASE_URL=https://cerpp.eprocurement.gov.gr/khmdhs-opendata

# --- Web presence search (Google via a SerpAPI-compatible provider) ---
# https://serpapi.com or a compatible provider (Serper, ValueSerp, ...).
# Without a key the app runs on realistic demo data for this source.
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search

# --- AI summary / sales insights ---
# https://console.anthropic.com — without a key the app falls back to a
# rule-based demo summary so the UI still works end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Supabase (optional) ---
# Without this, contractor contacts found via "Find contractor contact info"
# are still shown in the UI but not persisted. See src/lib/contractorDb.ts
# for the contractor_db table schema. Also reserved for search history /
# favorites — see roadmap.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
